{
  "manifest_version": 3,
  "name": "Блокировщик мразей",
  "version": "1.4.0",
  "description": "Массовая блокировка всех, кто лайкнул комментарий: открываете список «Нравится» и жмёте одну кнопку.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Блокировщик мразей"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": [
        "src/util.js",
        "src/fb-dom.js",
        "src/engine.js",
        "src/panel.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
